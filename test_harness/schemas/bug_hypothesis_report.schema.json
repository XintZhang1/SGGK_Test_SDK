{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sggk://schemas/bug_hypothesis_report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "failure_id",
    "assessment_status",
    "issue_classification",
    "summary",
    "hypotheses",
    "unresolved_questions",
    "evidence_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "bug_hypothesis_report"
    },
    "failure_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "assessment_status": {
      "const": "candidate_only"
    },
    "issue_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "confidence",
        "alternatives"
      ],
      "properties": {
        "kind": {
          "enum": [
            "sdk_bug_candidate",
            "test_generation_defect",
            "oracle_defect",
            "harness_defect",
            "environment_defect",
            "inconclusive"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "alternatives": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "claim_status",
          "category",
          "statement",
          "confidence",
          "suspect_locations",
          "supporting_evidence",
          "contradicting_evidence",
          "assumptions",
          "falsification_tests",
          "reproduction_path"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
          },
          "claim_status": {
            "const": "candidate_root_cause"
          },
          "category": {
            "enum": [
              "sdk_implementation",
              "topology_tracking",
              "api_contract",
              "test_generation",
              "validation_oracle",
              "harness_infrastructure",
              "environment",
              "unknown"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "confidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "score",
              "band",
              "basis"
            ],
            "properties": {
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "band": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            }
          },
          "suspect_locations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_ref_id",
                "symbol",
                "line_start",
                "line_end",
                "role",
                "rationale"
              ],
              "properties": {
                "source_ref_id": {
                  "type": "string",
                  "maxLength": 96
                },
                "symbol": {
                  "type": "string",
                  "maxLength": 256
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 0
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 0
                },
                "role": {
                  "enum": [
                    "possible_failure_site",
                    "caller",
                    "validation_site",
                    "topotrack_site",
                    "source_unavailable"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1600
                }
              }
            }
          },
          "supporting_evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "$ref": "#/$defs/evidence_assertion"
            }
          },
          "contradicting_evidence": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "$ref": "#/$defs/evidence_assertion"
            }
          },
          "assumptions": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 800
            }
          },
          "falsification_tests": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tool_id",
                "experiment",
                "expected_discriminator"
              ],
              "properties": {
                "tool_id": {
                  "type": "string",
                  "maxLength": 64
                },
                "experiment": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                },
                "expected_discriminator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                }
              }
            }
          },
          "reproduction_path": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reproduction_ref_id",
              "expected_signature_id",
              "stable_attempts"
            ],
            "properties": {
              "reproduction_ref_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "expected_signature_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "stable_attempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 96
      }
    }
  },
  "$defs": {
    "evidence_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "assertion"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "maxLength": 96
        },
        "assertion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    }
  }
}
