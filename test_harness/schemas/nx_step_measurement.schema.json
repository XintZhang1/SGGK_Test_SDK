{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sggk.local/schemas/nx_step_measurement.schema.json",
  "title": "NX STEP measurement",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "ok",
    "status",
    "input",
    "nx",
    "units",
    "import",
    "measurement",
    "diagnostics"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "sggk_nx_step_measurement" },
    "ok": { "type": "boolean" },
    "status": {
      "enum": ["invalid_request", "import_failed", "measurement_failed", "completed"]
    },
    "input": {
      "type": "object",
      "required": ["name", "sha256", "size_bytes"],
      "properties": {
        "name": { "type": "string" },
        "sha256": {
          "type": "string",
          "pattern": "^(|[0-9a-f]{64})$"
        },
        "size_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "nx": {
      "type": "object",
      "required": ["version", "full_version", "session_type"],
      "properties": {
        "version": { "type": "string" },
        "full_version": { "type": "string" },
        "session_type": { "type": "string" }
      },
      "additionalProperties": false
    },
    "units": {
      "type": "object",
      "required": ["length", "area", "volume"],
      "properties": {
        "length": { "const": "millimeter" },
        "area": { "const": "square_millimeter" },
        "volume": { "const": "cubic_millimeter" }
      },
      "additionalProperties": false
    },
    "import": {
      "type": "object",
      "required": [
        "ok",
        "protocol",
        "flatten_assembly",
        "body_count",
        "solid_body_count",
        "sheet_body_count",
        "unknown_body_count"
      ],
      "properties": {
        "ok": { "type": "boolean" },
        "protocol": { "const": "STEP AP214" },
        "flatten_assembly": { "const": true },
        "body_count": { "type": "integer", "minimum": 0 },
        "solid_body_count": { "type": "integer", "minimum": 0 },
        "sheet_body_count": { "type": "integer", "minimum": 0 },
        "unknown_body_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": [
        "ok",
        "accuracy",
        "body_count",
        "measured_body_count",
        "total_area",
        "total_abs_volume",
        "bodies"
      ],
      "properties": {
        "ok": { "type": "boolean" },
        "accuracy": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "body_count": { "type": "integer", "minimum": 0 },
        "measured_body_count": { "type": "integer", "minimum": 0 },
        "total_area": { "type": "number", "minimum": 0 },
        "total_abs_volume": { "type": "number", "minimum": 0 },
        "bodies": {
          "type": "array",
          "items": { "$ref": "#/$defs/body_measurement" }
        }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "body_measurement": {
      "type": "object",
      "required": [
        "index",
        "tag",
        "body_type",
        "measurement_ok",
        "area",
        "abs_volume",
        "error"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "tag": { "type": "integer", "minimum": 0 },
        "body_type": { "enum": ["solid", "sheet", "unknown"] },
        "measurement_ok": { "type": "boolean" },
        "area": { "type": "number", "minimum": 0 },
        "abs_volume": { "type": "number", "minimum": 0 },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^NX_[A-Z0-9_]+$" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
