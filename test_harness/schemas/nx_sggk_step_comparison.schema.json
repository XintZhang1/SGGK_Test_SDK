{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sggk.local/schemas/nx_sggk_step_comparison.schema.json",
  "title": "NX and SGGK STEP comparison",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "ok",
    "input",
    "tolerances",
    "nx",
    "sggk",
    "checks",
    "failures",
    "diagnostics"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "nx_sggk_step_comparison" },
    "ok": { "type": "boolean" },
    "input": {
      "type": "object",
      "required": ["same_input", "sha256", "nx_sha256", "sggk_sha256"],
      "properties": {
        "same_input": { "type": "boolean" },
        "sha256": { "type": "string", "pattern": "^(|[0-9a-f]{64})$" },
        "nx_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sggk_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "tolerances": {
      "type": "object",
      "required": ["abs_tol", "rel_tol", "formula"],
      "properties": {
        "abs_tol": { "type": "number", "minimum": 0 },
        "rel_tol": { "type": "number", "minimum": 0 },
        "formula": {
          "const": "abs(nx-sggk) <= abs_tol + rel_tol * max(abs(nx), abs(sggk))"
        }
      },
      "additionalProperties": false
    },
    "nx": { "$ref": "#/$defs/side" },
    "sggk": { "$ref": "#/$defs/side" },
    "checks": {
      "type": "object",
      "required": ["input_sha256", "import", "body_count", "total_area", "total_abs_volume"],
      "properties": {
        "input_sha256": { "$ref": "#/$defs/identity_check" },
        "import": { "$ref": "#/$defs/boolean_check" },
        "body_count": { "$ref": "#/$defs/count_check" },
        "total_area": { "$ref": "#/$defs/numeric_check" },
        "total_abs_volume": { "$ref": "#/$defs/numeric_check" }
      },
      "additionalProperties": false
    },
    "failures": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/representation_diagnostic" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "side": {
      "type": "object",
      "required": [
        "version",
        "import_ok",
        "measurement_ok",
        "body_count",
        "total_area",
        "total_abs_volume"
      ],
      "properties": {
        "version": { "type": "string" },
        "import_ok": { "type": "boolean" },
        "measurement_ok": { "type": "boolean" },
        "body_count": { "type": "integer", "minimum": 0 },
        "shell_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "total_area": { "type": "number", "minimum": 0 },
        "total_abs_volume": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "identity_check": {
      "type": "object",
      "required": ["kind", "ok", "nx", "sggk"],
      "properties": {
        "kind": { "const": "sha256_identity" },
        "ok": { "type": "boolean" },
        "nx": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sggk": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "boolean_check": {
      "type": "object",
      "required": ["kind", "ok", "expected", "nx", "sggk"],
      "properties": {
        "kind": { "const": "boolean_required_true" },
        "ok": { "type": "boolean" },
        "expected": { "const": true },
        "nx": { "type": "boolean" },
        "sggk": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "count_check": {
      "type": "object",
      "required": ["kind", "ok", "nx", "sggk", "delta"],
      "properties": {
        "kind": { "const": "exact_integer" },
        "ok": { "type": "boolean" },
        "nx": { "type": "integer", "minimum": 0 },
        "sggk": { "type": "integer", "minimum": 0 },
        "delta": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "numeric_check": {
      "type": "object",
      "required": [
        "kind",
        "ok",
        "nx",
        "sggk",
        "delta",
        "abs_delta",
        "tolerance",
        "abs_tol",
        "rel_tol"
      ],
      "properties": {
        "kind": { "const": "abs_rel_numeric" },
        "ok": { "type": "boolean" },
        "nx": { "type": "number", "minimum": 0 },
        "sggk": { "type": "number", "minimum": 0 },
        "delta": { "type": "number" },
        "abs_delta": { "type": "number", "minimum": 0 },
        "tolerance": { "type": "number", "minimum": 0 },
        "abs_tol": { "type": "number", "minimum": 0 },
        "rel_tol": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "representation_diagnostic": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "classification",
        "nx_body_count",
        "sggk_body_count",
        "sggk_shell_count",
        "geometry_bug_confirmed",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "NX_SGGK_COMPOUND_BODY_SHELL_AGGREGATION",
            "NX_SGGK_BODY_COUNT_REPRESENTATION_UNEXPLAINED"
          ]
        },
        "severity": { "enum": ["info", "warning"] },
        "classification": {
          "enum": [
            "cross_kernel_representation_difference",
            "unexplained_representation_difference"
          ]
        },
        "nx_body_count": { "type": "integer", "minimum": 0 },
        "sggk_body_count": { "type": "integer", "minimum": 0 },
        "sggk_shell_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "geometry_bug_confirmed": { "const": false },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
