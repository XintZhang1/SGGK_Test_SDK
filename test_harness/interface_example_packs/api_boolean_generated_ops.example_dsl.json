{
  "dsl_version": 1,
  "constants": {
    "topo_tol": 0.01,
    "geom_tol": 0.00001
  },
  "defaults": {
    "api": "api_boolean",
    "boolean_type": "SUBTRACTION",
    "modeling_tol": "topo_tol",
    "check_valid": true,
    "topo_track": false,
    "non_destructive": true,
    "expectations": {
      "result_bodies": {
        "min": 1
      },
      "require_property_calculations": true,
      "require_finite_properties": true,
      "require_nonnegative_length_area": true
    }
  },
  "cases": [
    {
      "case_id": "example_extrude_sweep_side",
      "hypothesis": "A generated extrusion side face is attacked by a swept circular tool near exact side contact.",
      "target": {
        "chain": [
          {
            "id": "target_rect_profile",
            "op": "rect_profile",
            "length": 200.0,
            "width": 120.0
          },
          {
            "id": "target_rect_extrude",
            "op": "extrude",
            "height": 120.0,
            "operation_tol": "topo_tol"
          },
          {
            "id": "target_origin",
            "op": "transform",
            "translate": [0.0, 0.0, 0.0]
          }
        ]
      },
      "tool": {
        "chain": [
          {
            "id": "tool_circle_profile",
            "op": "circle_profile",
            "radius": 25.0,
            "operation_tol": "topo_tol",
            "g1_tol": 0.1
          },
          {
            "id": "tool_line_sweep",
            "op": "sweep_line",
            "height": 160.0,
            "operation_tol": "topo_tol",
            "g1_tol": 0.1
          },
          {
            "id": "tool_side_place",
            "op": "transform",
            "translate_x": 125.0,
            "translate_y": 0.0,
            "translate_z": -20.0
          }
        ]
      },
      "variants": [
        {
          "suffix": "sub_overlap_topo",
          "set": {
            "options.boolean_type": "SUBTRACTION",
            "tool.chain.2.translate_x": "125.0 - topo_tol",
            "expectations.result_bodies.min": 1
          }
        },
        {
          "suffix": "int_exact",
          "set": {
            "options.boolean_type": "INTERSECTION",
            "tool.chain.2.translate_x": 125.0,
            "expectations.result_bodies.min": 0
          }
        }
      ]
    }
  ]
}
