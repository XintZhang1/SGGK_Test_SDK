{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 20, "patch": 0},
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/../build/test_harness",
      "cacheVariables": {
        "SGGK_SDK_DIR": "$env{SGGK_SDK_DIR}"
      }
    },
    {
      "name": "windows-local",
      "displayName": "Windows local SGGK SDK (VS 2022)",
      "inherits": "windows-base"
    },
    {
      "name": "windows-vs2026",
      "displayName": "Windows local SGGK SDK (VS 2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/../build/test_harness-vs2026",
      "cacheVariables": {
        "SGGK_SDK_DIR": "$env{SGGK_SDK_DIR}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-local",
      "configuration": "Release"
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-local",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2026-release",
      "configurePreset": "windows-vs2026",
      "configuration": "Release"
    },
    {
      "name": "windows-vs2026-debug",
      "configurePreset": "windows-vs2026",
      "configuration": "Debug"
    }
  ]
}
