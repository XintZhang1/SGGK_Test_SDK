{
  "dsl_version": 1,
  "constants": {
    "topo_tol": 0.01,
    "geom_tol": 0.00001,
    "max_model_size": 500000.0,
    "tau": "2 * pi"
  },
  "defaults": {
    "api": "api_boolean",
    "boolean_type": "SUBTRACTION",
    "modeling_tol": "topo_tol",
    "check_valid": true,
    "topo_track": false,
    "non_destructive": true,
    "expectations": {
      "result_bodies": {"min": 1},
      "require_finite_properties": true,
      "require_nonnegative_length_area": true
    }
  },
  "cases": [
    {
      "case_id": "tol_band_cylinder_cylinder_tangent",
      "hypothesis": "Two parallel cylinders are separated by R+r plus offsets around topology tolerance 1e-2 and geometry tolerance 1e-5.",
      "target": {
        "chain": [
          {"id": "target_cylinder", "op": "primitive", "kind": "solid_cylinder", "radius": 1000.0, "height": 3000.0, "angle": "tau"},
          {"id": "target_origin", "op": "transform", "translate": [0.0, 0.0, 0.0]}
        ]
      },
      "tool": {
        "chain": [
          {"id": "tool_cylinder", "op": "primitive", "kind": "solid_cylinder", "radius": 250.0, "height": 3200.0, "angle": "tau"},
          {"id": "tool_near_tangent_place", "op": "transform", "translate": [1250.0, 0.0, -100.0]}
        ]
      },
      "sweeps": [
        {
          "path": "tool.chain.1.translate.0",
          "values": [
            {"suffix": "overlap_topo_tol", "value": "1250.0 - topo_tol"},
            {"suffix": "overlap_geom_tol", "value": "1250.0 - geom_tol"},
            {"suffix": "exact_tangent", "value": 1250.0},
            {"suffix": "gap_geom_tol", "value": "1250.0 + geom_tol"},
            {"suffix": "gap_topo_tol", "value": "1250.0 + topo_tol"}
          ]
        }
      ]
    },
    {
      "case_id": "tol_band_extrude_side_cutter",
      "hypothesis": "A generated extrusion side face is cut by a cylinder whose side distance oscillates across 1e-2 while carrying 1e-5 perturbations.",
      "target": {
        "chain": [
          {"id": "target_profile", "op": "rect_profile", "length": 2000.0, "width": 1200.0},
          {"id": "target_extrude", "op": "extrude", "height": 1000.0, "operation_tol": "topo_tol"},
          {"id": "target_place", "op": "transform", "translate": [0.0, 0.0, 0.0]}
        ]
      },
      "tool": {
        "chain": [
          {"id": "side_tool_cylinder", "op": "primitive", "kind": "solid_cylinder", "radius": 120.0, "height": 1200.0, "angle": "tau"},
          {"id": "side_tool_place", "op": "transform", "translate": [1120.0, 0.0, -100.0]}
        ]
      },
      "sweeps": [
        {
          "path": "tool.chain.1.translate.0",
          "values": [
            {"suffix": "inside_topo_tol", "value": "1120.0 - topo_tol"},
            {"suffix": "inside_geom_tol", "value": "1120.0 - geom_tol"},
            {"suffix": "side_tangent", "value": 1120.0},
            {"suffix": "outside_geom_tol", "value": "1120.0 + geom_tol"},
            {"suffix": "outside_topo_tol", "value": "1120.0 + topo_tol"}
          ]
        }
      ]
    },
    {
      "case_id": "tol_band_large_coord_cylinders",
      "hypothesis": "Near-tangent cylinder subtraction at large coordinates below max modeling size 5e5 stresses absolute coordinate magnitude versus 1e-2 topology tolerance.",
      "target": {
        "chain": [
          {"id": "large_target_cylinder", "op": "primitive", "kind": "solid_cylinder", "radius": 50000.0, "height": 100000.0, "angle": "tau"},
          {"id": "large_target_place", "op": "transform", "translate": [350000.0, -120000.0, 0.0]}
        ]
      },
      "tool": {
        "chain": [
          {"id": "large_tool_cylinder", "op": "primitive", "kind": "solid_cylinder", "radius": 5000.0, "height": 110000.0, "angle": "tau"},
          {"id": "large_tool_place", "op": "transform", "translate": [405000.0, -120000.0, -5000.0]}
        ]
      },
      "sweeps": [
        {
          "path": "tool.chain.1.translate.0",
          "values": [
            {"suffix": "overlap_topo_tol", "value": "405000.0 - topo_tol"},
            {"suffix": "overlap_geom_tol", "value": "405000.0 - geom_tol"},
            {"suffix": "exact_tangent", "value": 405000.0},
            {"suffix": "gap_geom_tol", "value": "405000.0 + geom_tol"},
            {"suffix": "gap_topo_tol", "value": "405000.0 + topo_tol"}
          ]
        }
      ]
    }
  ]
}
