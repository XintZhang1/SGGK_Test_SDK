{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SGGK API Test Request Form",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "owner",
    "target_api",
    "test_goal",
    "risk_summary",
    "geometry",
    "oracles",
    "run_profile"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*$"
    },
    "owner": {
      "type": "string"
    },
    "target_api": {
      "type": "string",
      "minLength": 1,
      "description": "Requested SDK/harness API. Unknown APIs are allowed at form intake and should produce needs_harness_extension unless interface_capabilities.json supports them."
    },
    "sdk_source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "test_goal": {
      "type": "string"
    },
    "risk_summary": {
      "type": "string"
    },
    "geometry": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "family"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "description": "Geometry family label. Prefer known families from interface_capabilities.json, but allow new labels for extension intake."
        },
        "target_builder": {
          "type": "string"
        },
        "tool_builder": {
          "type": "string"
        },
        "input_asset": {
          "type": "string"
        },
        "parameter_notes": {
          "type": "string"
        }
      }
    },
    "tolerance_focus": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "exact_contact",
          "geom_tol",
          "topo_tol",
          "large_coordinate",
          "seam_periodic",
          "generated_topology",
          "roundtrip_drift",
          "import_topology"
        ]
      },
      "default": []
    },
    "oracles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_behavior": {
      "type": "string",
      "default": ""
    },
    "case_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 3
    },
    "run_profile": {
      "type": "string",
      "enum": [
        "single_case",
        "smoke",
        "matrix",
        "corpus",
        "known_bug_regression"
      ]
    },
    "campaign_profile": {
      "type": "string",
      "enum": [
        "abc_boolean_mass_recut"
      ],
      "description": "Optional typed large-campaign profile. The model may select only this id and bounded args; local code owns tool/path bindings."
    },
    "input_assets": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source_file": {
          "type": "string"
        },
        "dataset_root": {
          "type": "string"
        },
        "dataset_index": {
          "type": "string"
        }
      },
      "default": {}
    },
    "notes": {
      "type": "string",
      "default": ""
    }
  }
}
