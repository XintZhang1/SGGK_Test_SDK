    }
  ],
  "task_build_command": "python .\\test_harness\\tools\\build_api_test_task.py .\\test_harness\\forms\\interface_distillation\\<form>.json --out .\\artifacts\\interface_distillation_tasks\\<request_id>.json",
  "reporting_required": [
    "task JSON emitted by build_api_test_task.py",
    "model output JSON",
    "compile/check report when DSL or cluster_seed is used",
    "recipe_summary.json or corpus_summary.json",
    "triage_report.md",
    "preview contact.png when geometry is generated",
    "geometry_audit.md for tolerance clusters",
    "validation.json or roundtrip_comparison.json for failures"
  ]
}
