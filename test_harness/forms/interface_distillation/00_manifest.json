{
  "suite_id": "interface_distillation_v1",
  "goal": "Run every currently known harness-supported interface family through the source-guided small-model workflow: form -> model-authored DSL/recipe -> case cluster -> SDK run -> report.",
  "branch": "main",
  "runner": ".\\build\\test_harness\\Release\\sggk_case_runner.exe",
  "abc_inputs": {
    "preferred_fetch_root": ".\\artifacts\\abc_fetch_smoke",
    "dataset_index": ".\\artifacts\\abc_fetch_smoke\\dataset_index.json",
    "complex_dataset_index": ".\\artifacts\\abc_fetch_smoke\\complex_dataset_index.json",
    "imported_sgt_root": ".\\artifacts\\interface_distillation\\02_step_import_abc\\top_complex_import"
  },
  "forms": [
    {
      "order": 1,
      "form": "01_boolean_primitive_source_guided.json",
      "covers": ["api_boolean", "solid_cylinder", "solid_wedge"],
      "expected_model_output": "cluster_seed or attack_dsl"
    },
    {
      "order": 2,
      "form": "02_step_import_abc_complex.json",
      "covers": ["step_import", "ABC STEP corpus"],
      "expected_model_output": "flat_recipe or typed campaign_request"
    },
    {
      "order": 3,
      "form": "14_iges_import_abc_complex.json",
      "covers": ["iges_import", "ABC IGES corpus"],
      "expected_model_output": "flat_recipe or typed campaign_request"
    },
    {
      "order": 4,
      "form": "03_loaded_sgt_abc_recut_boolean.json",
      "covers": ["api_boolean", "loaded_sgt", "ABC imported SGT recut"],
      "expected_model_output": "attack_dsl or typed campaign_request"
    },
    {
      "order": 5,
      "form": "04_sweep_circle_line_boolean.json",
      "covers": ["api_boolean", "sweep_circle_line", "api_sweep_entity"],
      "expected_model_output": "cluster_seed or attack_dsl"
    },
    {
      "order": 6,
      "form": "05_support_sweep_bspline_boolean.json",
      "covers": ["api_boolean", "support_sweep_bspline_surface", "api_sweep_entity support-face mode"],
      "expected_model_output": "attack_dsl"
    },
    {
      "order": 7,
      "form": "06_extrude_rect_boolean.json",
      "covers": ["api_boolean", "extrude_rect", "api_extrude_entity"],
      "expected_model_output": "cluster_seed or attack_dsl"
    },
    {
      "order": 8,
      "form": "07_thicken_rect_sheet_boolean.json",
      "covers": ["api_boolean", "thicken_rect_sheet", "api_thicken_body"],
      "expected_model_output": "cluster_seed or attack_dsl"
    },
    {
      "order": 9,
      "form": "08_revolve_boolean.json",
      "covers": ["api_boolean", "revolve_line", "revolve_rect", "api_revolve_entity"],
      "expected_model_output": "cluster_seed or attack_dsl"
    },
    {
      "order": 10,
      "form": "09_preboolean_history_recut.json",
      "covers": ["api_boolean", "pre_boolean_cylinder_wedge", "operation history recut"],
      "expected_model_output": "attack_dsl"
    },
    {
      "order": 11,
      "form": "10_step_roundtrip_imported_sgt.json",
      "covers": ["step_roundtrip", "api_step_export", "api_step_import"],
      "expected_model_output": "flat_recipe"
    },
    {
      "order": 12,
      "form": "11_iges_roundtrip_imported_sgt.json",
